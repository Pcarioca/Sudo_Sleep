# ==============================================================================
# Sudo Sleep Backend — Local Environment Variables Template
# Copy this file to `backend/.env` (gitignored) or configure these variables in
# your IntelliJ IDEA Run Configuration / deployment environment.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- PostgreSQL (defaults match backend/docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/sudosleep
DB_USER=sudosleep
DB_PASSWORD=sudosleep

# --- Stateless JWT Auth (HS256; MUST be >= 32 bytes / 256 bits in production) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# --- Google Sign-In Verification ---
# Paste the "Web application" OAuth 2.0 Client ID from Google Cloud Console
# (the same Web Client ID passed to Android Credential Manager's setServerClientId).
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# --- Facebook Login Verification ---
# From Meta for Developers -> App Settings -> Basic
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- Forgot-Password Email (SMTP) ---
# Leave MAIL_HOST blank in local dev to log reset-email delivery warnings without crashing.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@sudosleep.app
